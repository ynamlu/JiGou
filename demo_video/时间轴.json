   "chapter": "07 收尾",
   "cues": [
    {
     "text": "以上就是极构需求诊断顾问。",
     "start": 0.0,
     "end": 2.7478498062015504
    },
    {
     "text": "它让不懂技术的人，",
     "start": 2.7478498062015504,
     "end": 4.650207364341085
    },
    {
     "text": "也能先把需求想清楚，再去找开发。",
     "start": 4.650207364341085,
     "end": 8.032176356589147
    },
    {
     "text": "谢谢大家。",
     "start": 8.032176356589147,
     "end": 9.089041666666667
    }
   ],
   "dur": 9.089041666666667,
   "start": 308.308125,
   "end": 317.3971666666667
  }
 ],
 "cues": [
  {
   "block_id": "B01",
   "block_tag": "开场",
   "chapter": "01 开场",
   "text": "大家好，我们是极构团队。",
   "start": 1.2,
   "end": 3.382484693877551,
   "dur": 2.182
  },
  {
   "block_id": "B01",
   "block_tag": "开场",
   "chapter": "01 开场",
   "text": "参赛作品是「极构 · 需求诊断顾问」，",
   "start": 3.382484693877551,
   "end": 6.838085459183674,
   "dur": 3.456
  },
  {
   "block_id": "B01",
   "block_tag": "开场",
   "chapter": "01 开场",
   "text": "参加 AI WEB 网页开发挑战赛。",
   "start": 6.838085459183674,
   "end": 10.1118125,
   "dur": 3.274
  },
  {
   "block_id": "B02",
   "block_tag": "缘起",
   "chapter": "01 开场",
   "text": "我们解决的问题很具体。",
   "start": 10.5318125,
   "end": 12.638053763440858,
   "dur": 2.106
  },
  {
   "block_id": "B02",
   "block_tag": "缘起",
   "chapter": "01 开场",
   "text": "很多创业者和个体店主想做一个系统，",
   "start": 12.638053763440858,
   "end": 15.893153897849462,
   "dur": 3.255
  },
  {
   "block_id": "B02",
   "block_tag": "缘起",
   "chapter": "01 开场",
   "text": "却说不清要做什么、大概多少钱、",
   "start": 15.893153897849462,
   "end": 18.765301075268816,
   "dur": 2.872
  },
  {
   "block_id": "B02",
   "block_tag": "缘起",
   "chapter": "01 开场",
   "text": "还缺哪些准备。",
   "start": 18.765301075268816,
   "end": 20.10563642473118,
   "dur": 1.34
  },
  {
   "block_id": "B02",
   "block_tag": "缘起",
   "chapter": "01 开场",
   "text": "极构用 AI 把一句「我想做个系统」，",
   "start": 20.10563642473118,
   "end": 23.74368951612903,
   "dur": 3.638
  },
  {
   "block_id": "B02",
   "block_tag": "缘起",
   "chapter": "01 开场",
   "text": "变成一份可以直接拿去开发、",
   "start": 23.74368951612903,
   "end": 26.23288373655914,
   "dur": 2.489
  },
  {
   "block_id": "B02",
   "block_tag": "缘起",
   "chapter": "01 开场",
   "text": "询价、立项的需求报告。",
   "start": 26.23288373655914,
   "end": 28.339124999999996,
   "dur": 2.106
  },
  {
   "block_id": "B03",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "产品有六块核心能力。",
   "start": 29.289125,
   "end": 31.658973710317458,
   "dur": 2.37
  },
  {
   "block_id": "B03",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "第一，AI 问卷和自由对话。",
   "start": 31.658973710317458,
   "end": 34.9767619047619,
   "dur": 3.318
  },
  {
   "block_id": "B03",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "问卷会一题一题追问，",
   "start": 34.9767619047619,
   "end": 37.34661061507936,
   "dur": 2.37
  },
  {
   "block_id": "B03",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "自由对话适合已经有想法的人。",
   "start": 37.34661061507936,
   "end": 40.66439880952381,
   "dur": 3.318
  },
  {
   "block_id": "B03",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "第二，五段式诊断报告。",
   "start": 40.66439880952381,
   "end": 43.27123239087302,
   "dur": 2.607
  },
  {
   "block_id": "B03",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "项目概述、已具备、还缺失、",
   "start": 43.27123239087302,
   "end": 46.35203571428572,
   "dur": 3.081
  },
  {
   "block_id": "B03",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "待确认清单、建议下一步。",
   "start": 46.35203571428572,
   "end": 49.19585416666666,
   "dur": 2.844
  },
  {
   "block_id": "B04",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "第三，六维成熟度评分和风险提示，",
   "start": 49.615854166666665,
   "end": 53.4574477739726,
   "dur": 3.842
  },
  {
   "block_id": "B04",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "一眼看出需求还想清了没。",
   "start": 53.4574477739726,
   "end": 56.338642979452054,
   "dur": 2.881
  },
  {
   "block_id": "B04",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "第四，三份交付物：",
   "start": 56.338642979452054,
   "end": 58.49953938356164,
   "dur": 2.161
  },
  {
   "block_id": "B04",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "PRD、开发询价清单、成本工期，",
   "start": 58.49953938356164,
   "end": 62.34113299086758,
   "dur": 3.842
  },
  {
   "block_id": "B04",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "外加 MVP 与完整版的 A/B 方案。",
   "start": 62.34113299086758,
   "end": 67.143125,
   "dur": 4.802
  },
  {
   "block_id": "B05",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "第五，验收版本。",
   "start": 67.563125,
   "end": 69.25156037414966,
   "dur": 1.688
  },
  {
   "block_id": "B05",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "每次确认生成版本号、指纹和 diff，",
   "start": 69.25156037414966,
   "end": 73.2615943877551,
   "dur": 4.01
  },
  {
   "block_id": "B05",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "留下书面凭证。",
   "start": 73.2615943877551,
   "end": 74.73897534013605,
   "dur": 1.477
  },
  {
   "block_id": "B05",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "第六，模板库、我的图纸和多格式导出，",
   "start": 74.73897534013605,
   "end": 78.53795493197279,
   "dur": 3.799
  },
  {
   "block_id": "B05",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "报告可以导出 Markdown、PDF 和长截图。",
   "start": 78.53795493197279,
   "end": 83.81431547619047,
   "dur": 5.276
  },
  {
   "block_id": "B05",
   "block_tag": "功能地图",
   "chapter": "02 功能",
   "text": "这就是从一句想法，到可执行材料的完整闭环。",
   "start": 83.81431547619047,
   "end": 88.24645833333334,
   "dur": 4.432
  },
  {
   "block_id": "B06",
   "block_tag": "技术栈",
   "chapter": "03 技术栈",
   "text": "技术栈分三层。",
   "start": 89.19645833333334,
   "end": 90.12159556574925,
   "dur": 0.925
  },
  {
   "block_id": "B06",
   "block_tag": "技术栈",
   "chapter": "03 技术栈",
   "text": "前端是 Vue 3.5 + Vite 8，",
   "start": 90.12159556574925,
   "end": 92.89700726299695,
   "dur": 2.775
  },
  {
   "block_id": "B06",
   "block_tag": "技术栈",
   "chapter": "03 技术栈",
   "text": "Pinia 管理账号、对话和报告状态，",
   "start": 92.89700726299695,
   "end": 95.40809403669725,
   "dur": 2.511
  },
  {
   "block_id": "B06",
   "block_tag": "技术栈",
   "chapter": "03 技术栈",
   "text": "Vue Router 做登录守卫；",
   "start": 95.40809403669725,
   "end": 97.65485588685016,
   "dur": 2.247
  },
  {
   "block_id": "B06",
   "block_tag": "技术栈",
   "chapter": "03 技术栈",
   "text": "Markdown 用 markdown-it 渲染，",
   "start": 97.65485588685016,
   "end": 101.09107989296636,
   "dur": 3.436
  },
  {
   "block_id": "B06",
   "block_tag": "技术栈",
   "chapter": "03 技术栈",
   "text": "highlight.js 做代码高亮。",
   "start": 101.09107989296636,
   "end": 103.60216666666668,
   "dur": 2.511
  },
  {
   "block_id": "B07",
   "block_tag": "技术栈",
   "chapter": "03 技术栈",
   "text": "后端是 FastAPI + Uvicorn，",
   "start": 104.02216666666666,
   "end": 106.82237214052287,
   "dur": 2.8
  },
  {
   "block_id": "B07",
   "block_tag": "技术栈",
   "chapter": "03 技术栈",
   "text": "AI 编排用 LangChain 1.4 和 LangGraph 1.2，",
   "start": 106.82237214052287,
   "end": 111.53180861928104,
   "dur": 4.709
  },
  {
   "block_id": "B07",
   "block_tag": "技术栈",
   "chapter": "03 技术栈",
   "text": "模型通过 OpenAI 兼容网关接入",
   "start": 111.53180861928104,
   "end": 113.8228858251634,
   "dur": 2.291
  },
  {
   "block_id": "B07",
   "block_tag": "技术栈",
   "chapter": "03 技术栈",
   "text": "deepseek-v4.1-flash-1017。",
   "start": 113.8228858251634,
   "end": 117.0049375,
   "dur": 3.182
  },
  {
   "block_id": "B08",
   "block_tag": "RAG 双通道",
   "chapter": "03 技术栈",
   "text": "RAG 是双通道。",
   "start": 117.4249375,
   "end": 119.02284782608696,
   "dur": 1.598
  },
  {
   "block_id": "B08",
   "block_tag": "RAG 双通道",
   "chapter": "03 技术栈",
   "text": "配置了向量模型，就走 Chroma 相似度检索，",
   "start": 119.02284782608696,
   "end": 123.2839420289855,
   "dur": 4.261
  },
  {
   "block_id": "B08",
   "block_tag": "RAG 双通道",
   "chapter": "03 技术栈",
   "text": "否则自动降级到自研 BM25；",
   "start": 123.2839420289855,
   "end": 125.9471259057971,
   "dur": 2.663
  },
  {
   "block_id": "B08",
   "block_tag": "RAG 双通道",
   "chapter": "03 技术栈",
   "text": "知识库是 12 篇原创文档、32 个片段。",
   "start": 125.9471259057971,
   "end": 129.67558333333332,
   "dur": 3.728
  },
  {
   "block_id": "B09",
   "block_tag": "数据层",
   "chapter": "03 技术栈",
   "text": "数据层只用单文件 SQLite，",
   "start": 130.09558333333334,
   "end": 132.88710416666666,
   "dur": 2.792
  },
  {
   "block_id": "B09",
   "block_tag": "数据层",
   "chapter": "03 技术栈",
   "text": "密码用 PBKDF2-SHA256 加随机盐；",
   "start": 132.88710416666666,
   "end": 136.89991536458334,
   "dur": 4.013
  },
  {
   "block_id": "B09",
   "block_tag": "数据层",
   "chapter": "03 技术栈",
   "text": "PDF 用 reportlab 排版，",
   "start": 136.89991536458334,
   "end": 140.21484635416667,
   "dur": 3.315
  },
  {
   "block_id": "B09",
   "block_tag": "数据层",
   "chapter": "03 技术栈",
   "text": "长截图用 html2canvas。",
   "start": 140.21484635416667,
   "end": 143.18083723958333,
   "dur": 2.966
  },
  {
   "block_id": "B09",
   "block_tag": "数据层",
   "chapter": "03 技术栈",
   "text": "整套系统不依赖数据库服务或容器，",
   "start": 143.18083723958333,
   "end": 145.97235807291668,
   "dur": 2.792
  },
  {
   "block_id": "B09",
   "block_tag": "数据层",
   "chapter": "03 技术栈",
   "text": "python run.py 一条命令启动。",
   "start": 145.97235807291668,
   "end": 149.63622916666668,
   "dur": 3.664
  },
  {
   "block_id": "B10",
   "block_tag": "登录",
   "chapter": "04 操作演示",
   "text": "系统是本地运行的完整 Web 应用。",
   "start": 150.58622916666667,
   "end": 154.03399890350877,
   "dur": 3.448
  },
  {
   "block_id": "B10",
   "block_tag": "登录",
   "chapter": "04 操作演示",
   "text": "首次使用先注册，",
   "start": 154.03399890350877,
   "end": 155.56634100877193,
   "dur": 1.532
  },
  {
   "block_id": "B10",
   "block_tag": "登录",
   "chapter": "04 操作演示",
   "text": "手机号加强度校验的密码。",
   "start": 155.56634100877193,
   "end": 157.86485416666667,
   "dur": 2.299
  },
  {
   "block_id": "B11",
   "block_tag": "首页",
   "chapter": "04 操作演示",
   "text": "登录后进入首页。",
   "start": 158.28485416666666,
   "end": 159.87866477272726,
   "dur": 1.594
  },
  {
   "block_id": "B11",
   "block_tag": "首页",
   "chapter": "04 操作演示",
   "text": "这里给出两种诊断方式：",
   "start": 159.87866477272726,
   "end": 162.0701543560606,
   "dur": 2.191
  },
  {
   "block_id": "B11",
   "block_tag": "首页",
   "chapter": "04 操作演示",
   "text": "问卷适合还说不清的人，",
   "start": 162.0701543560606,
   "end": 164.26164393939393,
   "dur": 2.191
  },
  {
   "block_id": "B11",
   "block_tag": "首页",
   "chapter": "04 操作演示",
   "text": "自由对话适合已经有想法的人。",
   "start": 164.26164393939393,
   "end": 167.0508125,
   "dur": 2.789
  },
  {
   "block_id": "B12",
   "block_tag": "账号隔离",
   "chapter": "04 操作演示",
   "text": "右上角是当前账号，",
   "start": 167.4708125,
   "end": 169.42970703125,
   "dur": 1.959
  },
  {
   "block_id": "B12",
   "block_tag": "账号隔离",
   "chapter": "04 操作演示",
   "text": "报告和验收记录按账号隔离，",
   "start": 169.42970703125,
   "end": 172.25922135416667,
   "dur": 2.83
  },
  {
   "block_id": "B12",
   "block_tag": "账号隔离",
   "chapter": "04 操作演示",
   "text": "换账号不会互相看到。",
   "start": 172.25922135416667,
   "end": 174.43577083333332,
   "dur": 2.177
  },
  {
   "block_id": "B13",
   "block_tag": "AI 问卷",
   "chapter": "04 操作演示",
   "text": "问卷不是固定题库，",
   "start": 174.85577083333334,
   "end": 176.74636974110032,
   "dur": 1.891
  },
  {
   "block_id": "B13",
   "block_tag": "AI 问卷",
   "chapter": "04 操作演示",
   "text": "而是 AI 根据上一题动态生成下一题。",
   "start": 176.74636974110032,
   "end": 180.73763410194175,
   "dur": 3.991
  },
  {
   "block_id": "B13",
   "block_tag": "AI 问卷",
   "chapter": "04 操作演示",
   "text": "比如我先选微信小程序，",
   "start": 180.73763410194175,
   "end": 183.04836610032362,
   "dur": 2.311
  },
  {
   "block_id": "B13",
   "block_tag": "AI 问卷",
   "chapter": "04 操作演示",
   "text": "再说给门店顾客用，",
   "start": 183.04836610032362,
   "end": 184.93896500809063,
   "dur": 1.891
  },
  {
   "block_id": "B13",
   "block_tag": "AI 问卷",
   "chapter": "04 操作演示",
   "text": "它会继续追问核心功能和预算。",
   "start": 184.93896500809063,
   "end": 187.87989664239484,
   "dur": 2.941
  },
  {
   "block_id": "B13",
   "block_tag": "AI 问卷",
   "chapter": "04 操作演示",
   "text": "每道题都能补充说明，",
   "start": 187.87989664239484,
   "end": 189.98056209546925,
   "dur": 2.101
  },
  {
   "block_id": "B13",
   "block_tag": "AI 问卷",
   "chapter": "04 操作演示",
   "text": "也能回上一题修改；",
   "start": 189.98056209546925,
   "end": 191.87116100323624,
   "dur": 1.891
  },
  {
   "block_id": "B13",
   "block_tag": "AI 问卷",
   "chapter": "04 操作演示",
   "text": "信息够了，它会主动收尾，",
   "start": 191.87116100323624,
   "end": 194.39195954692556,
   "dur": 2.521
  },
  {
