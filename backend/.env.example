# 本地开发用：复制本文件为 backend/.env，填入真实 Key（该文件已在 .gitignore 中忽略）
LLM_API_KEY=在这里填你的_API_Key
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
LLM_MODEL=deepseek-v4.1-flash-1017

# 可选：网关支持时显式控制思考过程（留空=不发送该参数）
# LLM_ENABLE_THINKING=0

# 可选：配置后才会构建向量库；留空则使用本地关键词检索
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# 可选：SQLite 数据库文件位置，默认 data/jigou.db（相对 backend 目录）
# DB_PATH=data/jigou.db
